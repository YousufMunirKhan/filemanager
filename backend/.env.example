# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---------- Flask ----------
# Use long random values in any shared/deployed environment:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too-use-at-least-32-characters

# Access-token lifetime in minutes (session timeout, NFR-02)
JWT_ACCESS_TOKEN_EXPIRES_MIN=30

# ---------- Two-step verification (email code) ----------
# true  = a 6-digit code is emailed when someone creates an account and every time they sign in
# false = sign in with email + password only
TWO_FACTOR_ENABLED=true
OTP_EXPIRES_MIN=10

# ---------- Email server for the codes ----------
# Codes are ONLY sent by email, never shown on screen. With SMTP_HOST empty, sign-up and sign-in stop
# with "the email server isn't set up" - so fill in the SMTP settings below.
# EMAIL_DEMO_MODE=true (demo without an email server only): the code is shown on screen instead.
# Ignored once SMTP_HOST is set.
EMAIL_DEMO_MODE=false
# Gmail: turn on 2-Step Verification for the Google account, create an "App password"
#        (Google Account > Security > App passwords) and use it as SMTP_PASSWORD.
# Hostinger / most hosting mailboxes: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465, SMTP_USE_SSL=true
#        (or SMTP_PORT=587, SMTP_USE_SSL=false, SMTP_USE_TLS=true), username = the full email address.
# Put the password in single quotes if it has special characters: SMTP_PASSWORD='p|a:s~s'
# Check the settings with:  flask --app run.py send-test-email you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# SSL from the start (port 465). If this line is left out it is on for port 465 and off otherwise.
# SMTP_USE_SSL=true
# STARTTLS (port 587). Ignored when SMTP_USE_SSL is on.
SMTP_USE_TLS=true
# Shown as the sender. Most servers require the same address as SMTP_USERNAME, e.g. FileAI <you@yourdomain.com>
MAIL_FROM=

# ---------- MySQL ----------
# Laragon / XAMPP default: user root with no password on port 3306
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/file_organizer?charset=utf8mb4

# ---------- File storage ----------
# local = files saved in backend/uploads (development)
# s3    = AWS S3 bucket (fill in the AWS settings below)
STORAGE_BACKEND=local
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Download links expire after this many seconds
S3_PRESIGNED_URL_EXPIRES_SEC=300

# ---------- Uploads ----------
MAX_UPLOAD_MB=20
STORAGE_QUOTA_MB=1024

# ---------- OCR ----------
# Path to tesseract.exe if it is not on PATH.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# ---------- AI ----------
# Paste an OpenAI key here to use GPT for analysis, folder choice and reading scans/photos.
# Never commit it: GitHub is public and OpenAI switches off keys that appear there.
OPENAI_API_KEY=
# Leave empty to choose automatically: openai when OPENAI_API_KEY is set, otherwise local.
# local  = built-in analyser, no API key needed
# openai = OpenAI GPT; falls back to local if the API fails
AI_PROVIDER=
OPENAI_MODEL=gpt-4o-mini

# Embeddings for search and similar-document detection:
# local | openai | sentence-transformers (pip install sentence-transformers first)
# After changing this, run:  flask --app run.py reindex
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Similarity (0-1) above which two documents are flagged as "similar"
SIMILARITY_THRESHOLD=0.90
# Classification confidence (0-1) below which the UI asks the user to double-check
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.60

# ---------- Background processing ----------
PROCESSING_WORKERS=2
